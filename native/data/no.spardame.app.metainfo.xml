  </categories>
  <keywords>
    <keyword>hearts</keyword>
    <keyword>cards</keyword>
    <keyword>spardame</keyword>
    <keyword>hjerter</keyword>
  </keywords>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <releases>
